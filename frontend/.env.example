# API Gateway Endpoint
# Local browser / Bare-metal: /api/v1 (proxied via Vite dev server)
# Docker Compose: /api/v1
VITE_API_BASE=/api/v1
# Direct backend runtime url (optional if proxied):
# Local: http://localhost:8000
# Docker container network: http://backend:8000
VITE_RUNTIME_URL=http://localhost:8000

# Public Payment Gateway Keys (Test / Sandbox only)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_SAFEPAY_PUBLIC_KEY=sec_...
