# ==============================================================================
# ROXY-AI 2.0 — MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` for local development or customize for deployment.
# NEVER commit files containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Environment & Identity
# ------------------------------------------------------------------------------
APP_ENV=development                       # development | test | staging | production
ROXY_VERSION=2.0.0
COMMIT_SHA=local                          # Set by CI/CD build to git commit hash (e.g. 6becde7)
HOST=0.0.0.0
PORT=8000
APP_BASE_URL=http://localhost:5173        # Public web application base URL
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
# Local Docker Compose:   postgresql+asyncpg://postgres:postgres@db:5432/roxy_dev
# Local Bare-metal:       postgresql+asyncpg://postgres:postgres@localhost:5432/roxy_dev
# Cloud SQL (Private IP): postgresql+asyncpg://roxy_user:CHANGE_ME@10.0.0.3:5432/roxy_prod
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/roxy_dev
STRICT_MIGRATIONS=false                   # Set to true in production to fail deployment on migration error

# ------------------------------------------------------------------------------
# Cache & Rate Limiting (Redis 7)
# ------------------------------------------------------------------------------
# Local Docker Compose:   redis://redis:6379/0
# Local Bare-metal:       redis://localhost:6379/0
# Managed Redis:          rediss://default:CHANGE_ME@redis.example.com:6380/0
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_TOKENS_PER_MINUTE=10000

# ------------------------------------------------------------------------------
# Authentication & Security (Server-Side Secrets ONLY)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-random-32-byte-hex-string
JWT_SERVICE_SECRET=replace-me-with-a-random-32-byte-hex-string
JWT_EXPIRY_HOURS=168
MAGIC_LINK_TTL_MINUTES=15

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of origins permitted to communicate with the API Gateway
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# AI Provider Credentials (Multi-Provider Gateway)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Provider Feature Flags
PROVIDER_GEMINI_ENABLED=true
PROVIDER_GROK_ENABLED=true
PROVIDER_DEEPSEEK_ENABLED=false
PROVIDER_OPENAI_ENABLED=false

# ------------------------------------------------------------------------------
# Storage Configuration (Local Volumes vs Cloud Object Storage)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local                     # local | gcs | s3
MEDIA_STORAGE_PATH=/app/static/media
# GCS_BUCKET_NAME=roxy-media-prod         # Required if STORAGE_BACKEND=gcs
# AWS_S3_BUCKET_NAME=roxy-media-prod     # Required if STORAGE_BACKEND=s3

# ------------------------------------------------------------------------------
# Payment Gateways (Stripe + Safepay + NayaPay + SadaPay)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER_MODE=automatic           # automatic | stripe | safepay | nayapay | sadapay
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENVIRONMENT=sandbox

# NayaPay Sandbox Integration (Pakistani Rupee - PKR)
# Obtain sandbox credentials from NayaPay Merchant Portal (https://nayapay.com)
NAYAPAY_ENABLED=false
NAYAPAY_ENVIRONMENT=sandbox
NAYAPAY_API_BASE_URL=https://sandbox.nayapay.com/api/v1
NAYAPAY_CHECKOUT_BASE_URL=https://sandbox-checkout.nayapay.com
NAYAPAY_CLIENT_ID=
NAYAPAY_SECRET_KEY=
NAYAPAY_MERCHANT_ID=
NAYAPAY_WEBHOOK_SECRET=
NAYAPAY_TIMEOUT_SECONDS=15

# SadaPay / SadaBiz Sandbox Integration (Pakistani Rupee - PKR)
# Obtain sandbox API key & merchant ID from SadaBiz Portal (https://sadapay.pk)
SADAPAY_ENABLED=false
SADAPAY_ENVIRONMENT=sandbox
SADAPAY_API_BASE_URL=https://sandbox.sadapay.pk/api/v1
SADAPAY_CHECKOUT_BASE_URL=https://sandbox-pay.sadapay.pk
SADAPAY_API_KEY=
SADAPAY_MERCHANT_ID=
SADAPAY_WEBHOOK_SECRET=
SADAPAY_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# Frontend Public Environment Variables (Vite & Next.js)
# ------------------------------------------------------------------------------
VITE_API_BASE=/api/v1
VITE_RUNTIME_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
