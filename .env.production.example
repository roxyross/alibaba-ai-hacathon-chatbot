# ==============================================================================
# ROXY-AI 2.0 — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.production.example)
# ==============================================================================
# Strict security, SSL enforcement, managed secrets, and zero-trust configuration.
# All secret values must be injected via Secret Manager (e.g. GCP Secret Manager,
# AWS Secrets Manager, Vault, or Protected GitHub Release Secrets).
# ==============================================================================

APP_ENV=production
ROXY_VERSION=2.0.0
COMMIT_SHA=RELEASE_GIT_COMMIT_SHA
HOST=0.0.0.0
PORT=8000
APP_BASE_URL=https://roxy.ai
LOG_LEVEL=INFO

# Production PostgreSQL 16 + pgvector (e.g. GCP Cloud SQL / AWS RDS / Neon / Supabase)
DATABASE_URL=postgresql+asyncpg://roxy_prod_user:CHANGE_ME_STRONG_PASSWORD@prod-db.internal:5432/roxy_prod
STRICT_MIGRATIONS=true                   # In production, migration failure MUST halt deployment

# Production High-Availability Redis 7 (e.g. GCP Memorystore / Redis Cloud / ElastiCache)
REDIS_URL=rediss://default:CHANGE_ME_REDIS_PASSWORD@prod-redis.internal:6380/0
RATE_LIMIT_TOKENS_PER_MINUTE=60000

# Cryptographic Secrets — Minimum 32 bytes (generate with `openssl rand -hex 32`)
JWT_SECRET=CHANGE_ME_PRODUCTION_32_BYTE_HEX_KEY
JWT_SERVICE_SECRET=CHANGE_ME_PRODUCTION_SERVICE_32_BYTE_HEX_KEY
JWT_EXPIRY_HOURS=168
MAGIC_LINK_TTL_MINUTES=15

# Strict Production CORS (Never allow wildcard origins in production)
CORS_ALLOWED_ORIGINS=https://roxy.ai,https://app.roxy.ai,https://www.roxy.ai

# Production AI Provider Credentials
GEMINI_API_KEY=CHANGE_ME_GEMINI_PRODUCTION_KEY
GROK_API_KEY=CHANGE_ME_GROK_PRODUCTION_KEY
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

PROVIDER_GEMINI_ENABLED=true
PROVIDER_GROK_ENABLED=true
PROVIDER_DEEPSEEK_ENABLED=false
PROVIDER_OPENAI_ENABLED=false

# High-Durability Cloud Object Storage (GCS or S3)
STORAGE_BACKEND=gcs                      # gcs | s3 | local
GCS_BUCKET_NAME=roxy-prod-media-storage
MEDIA_STORAGE_PATH=/app/static/media

# Live Production Payment Gateways (Stripe + Safepay)
PAYMENT_PROVIDER_MODE=automatic
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
SAFEPAY_API_KEY=sec_live_CHANGE_ME
SAFEPAY_WEBHOOK_SECRET=whsec_live_CHANGE_ME
SAFEPAY_ENVIRONMENT=production

# Public Frontend Configuration (Embedded in client bundle at build time)
VITE_API_BASE=/api/v1
VITE_RUNTIME_URL=https://roxy.ai
NEXT_PUBLIC_API_URL=https://roxy.ai
