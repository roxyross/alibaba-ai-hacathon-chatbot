# --- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8001

# --- Backend AI gateway ----------------------------------------------------
# The runtime calls the backend at this URL for LLM inference and auth.
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_PREFIX=/api/v1

# --- JWT validation --------------------------------------------------------
# Same secret the backend uses to mint magic-link session JWTs.
# Read from the backend/.env (do not duplicate the secret generation logic).
JWT_SECRET=change-me-in-prod-and-make-sure-it-matches-backend
JWT_ALGORITHM=HS256
JWT_AUDIENCE=roxy-web

# --- Agent and skill definitions ------------------------------------------
# Where the runtime reads .md files at startup. By default, the project's
# own .claude/ tree. Override only for testing.
AGENTS_DIR=../.claude/agents
SKILLS_DIR=../.claude/skills

# --- Coordinator classifier ------------------------------------------------
# v1: keyword + description-similarity. v2: LLM-based (out of scope for PR 2).
CLASSIFIER_V1_KEYWORD_WEIGHT=0.6
CLASSIFIER_V1_SIMILARITY_WEIGHT=0.4
CLASSIFIER_UNCERTAIN_THRESHOLD=0.05
CLASSIFIER_MARGIN=1.02  # top agent must exceed this ratio over runner-up to avoid uncertain

# --- Timeouts --------------------------------------------------------------
SPECIALIST_TIMEOUT_SECONDS=30
GATEWAY_TIMEOUT_SECONDS=10

# --- Rate limiting ---------------------------------------------------------
# Per-user message rate limit on POST /api/v1/runtime/chat (spec §10.7).
# 60/min allows normal chat plus occasional voice-dictation bursts.
RATE_LIMIT_PER_MINUTE=60

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Google AI (Gemini Live API + Cloud TTS) -------------------------------
# API key for Gemini Live API (STT) and Cloud TTS.
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# --- Web Search (Tavily + Google Search via SerpAPI) -----------------------
# Tavily — free tier at https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key-here
# Google Search via SerpAPI — free tier at https://serpapi.com
# Also set GOOGLE_SEARCH_ENGINE_ID (your Search Engine ID from Google Programmable Search)
GOOGLE_SEARCH_API_KEY=your-serpapi-google-api-key-here
GOOGLE_SEARCH_ENGINE_ID=your-google-search-engine-id-here

# --- Embedding model for RAG -----------------------------------------------
# Gemini embedding model used for document chunk vectors.
EMBEDDING_MODEL=embedding-001

# --- Google Cloud TTS -------------------------------------------------------
# Default voice for text_to_speech.
TTS_VOICE=en-US-Neural2-J
TTS_LANGUAGE_CODE=en-US
TTS_SPEED=1.0
TTS_PITCH=0.0

# --- DB (Neon PostgreSQL + pgvector) --------------------------------------
# Connection string for the Neon PostgreSQL database.
# Must have pgvector extension enabled: CREATE EXTENSION IF NOT EXISTS vector;
# Then create table: CREATE TABLE document_chunks (id UUID PRIMARY KEY, user_id TEXT NOT NULL, document_id TEXT NOT NULL, document_name TEXT NOT NULL, chunk_index INTEGER NOT NULL, chunk_text TEXT NOT NULL, embedding vector(768), created_at TIMESTAMPTZ DEFAULT NOW());
DATABASE_URL=postgresql://user:pass@host.neon.tech/neondb?sslmode=require
