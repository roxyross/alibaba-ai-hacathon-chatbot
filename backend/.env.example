# AI Gateway — Environment Variables
# Copy to .env and fill in your values

# -----------------------------------------------------------------------------
# Database (T027 — SQLAlchemy async + PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
# Bare-metal local:   postgresql+asyncpg://postgres:postgres@localhost:5432/roxy_dev
# Docker Compose:      postgresql+asyncpg://postgres:postgres@db:5432/roxy_dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/roxy_dev

# -----------------------------------------------------------------------------
# Provider API Keys
# -----------------------------------------------------------------------------
# Active providers: Gemini (primary) → Grok (fallback)
DEEPSEEK_API_KEY=sk-...
GROK_API_KEY=...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# -----------------------------------------------------------------------------
# Provider Feature Flags
# -----------------------------------------------------------------------------
# Active: Gemini + Grok. DeepSeek & OpenAI disabled (kept for future re-enable).
PROVIDER_DEEPSEEK_ENABLED=false
PROVIDER_GROK_ENABLED=true
PROVIDER_OPENAI_ENABLED=false
PROVIDER_GEMINI_ENABLED=true

# -----------------------------------------------------------------------------
# Circuit Breaker (optional — defaults in code)
# -----------------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_RESET_SECONDS=30

# -----------------------------------------------------------------------------
# Rate Limiting & Background Jobs (Redis)
# -----------------------------------------------------------------------------
# Bare-metal local:   redis://localhost:6379/0
# Docker Compose:      redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_TOKENS_PER_MINUTE=10000

# -----------------------------------------------------------------------------
# Token Log Retention
# -----------------------------------------------------------------------------
TOKEN_LOG_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Authentication — Magic link + JWT
# -----------------------------------------------------------------------------
# JWT_SECRET=replace-me-with-a-long-random-string
# MAGIC_LINK_TTL_MINUTES=15
# JWT_EXPIRY_HOURS=168
# APP_BASE_URL=http://localhost:5173
# APP_ENV=development   # set to "production" to enable Secure cookies + secure redirects

# -----------------------------------------------------------------------------
# Authentication — Google OAuth
# -----------------------------------------------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be exactly:
#   <OAUTH_REDIRECT_BASE_URL>/api/v1/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# GOOGLE_ALLOWED_EMAILS=   # optional comma-separated allowlist for hackathon demo

# -----------------------------------------------------------------------------
# Authentication — GitHub OAuth
# -----------------------------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must be exactly:
#   <OAUTH_REDIRECT_BASE_URL>/api/v1/auth/oauth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ALLOWED_EMAILS=   # optional comma-separated allowlist for hackathon demo

# -----------------------------------------------------------------------------
# SMTP Email Dispatch (Real inboxes delivery for Magic Links & Email Send Skill)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=ROXY AI <your_email@gmail.com>
# SMTP_TLS=true

# -----------------------------------------------------------------------------
# Plaid API (Bank Connect)
# -----------------------------------------------------------------------------
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENVIRONMENT=sandbox

# -----------------------------------------------------------------------------
# Web Search (Tavily + Google Search via SerpAPI)
# -----------------------------------------------------------------------------
# TAVILY_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=

# -----------------------------------------------------------------------------
# Runtime Service (document upload + RAG)
# -----------------------------------------------------------------------------
# URL of the runtime service (default: localhost:8000)
RUNTIME_BASE_URL=http://localhost:8000
JWT_SECRET=replace-me-with-a-long-random-string

# -----------------------------------------------------------------------------
# Payment Providers — Dual Engine (Stripe + Safepay)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER_MODE=automatic
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# SAFEPAY_API_KEY=
# SAFEPAY_WEBHOOK_SECRET=
# SAFEPAY_ENVIRONMENT=sandbox

# -----------------------------------------------------------------------------
# Universal WhatsApp Integration (Desktop, Web, Cloud API)
# -----------------------------------------------------------------------------
WHATSAPP_INTEGRATION_ENABLED=true
# Test recipient allowlist: single or comma-separated E.164 phone numbers
ROXY_WHATSAPP_TEST_RECIPIENT=+14155552671
WHATSAPP_TEST_RECIPIENT_ALLOWLIST=+14155552671

# Live physical desktop GUI interaction opt-in
ROXY_LIVE_WHATSAPP_GUI=0

# Official Meta WhatsApp Business Platform Cloud API (Graph API v21.0)
WHATSAPP_API_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEST_MODE=true

# -----------------------------------------------------------------------------
# Android Mobile Automation Bridge (ADB & Companion Protocol)
# -----------------------------------------------------------------------------
# Path to local adb binary if not in system PATH
# ANDROID_ADB_PATH=C:\platform-tools\adb.exe
# Target Android device serial or IP:port (default uses first available)
# ANDROID_DEFAULT_DEVICE_ID=


