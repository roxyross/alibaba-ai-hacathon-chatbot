# ==============================================================================
# ROXY-AI 2.0 — TEST ENVIRONMENT CONFIGURATION TEMPLATE (.env.test.example)
# ==============================================================================
# Used during automated testing and CI runners.
# In-memory fallbacks or transient test containers are utilized.
# ==============================================================================

APP_ENV=test
ROXY_VERSION=2.0.0-test
COMMIT_SHA=test-runner
HOST=127.0.0.1
PORT=8001
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=WARNING

# Test Database — Uses transient local test database or in-memory fallback
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/roxy_test
STRICT_MIGRATIONS=false

# Test Redis — Transient cache or mock
REDIS_URL=redis://localhost:6379/15
RATE_LIMIT_TOKENS_PER_MINUTE=1000000

# Fixed test secrets (safe for CI runners only)
JWT_SECRET=roxy_test_environment_secret_key_32_bytes_min!!
JWT_SERVICE_SECRET=roxy_test_service_secret_key_32_bytes_min!!
JWT_EXPIRY_HOURS=24
MAGIC_LINK_TTL_MINUTES=5

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Mocked / Sandbox Provider Keys
GEMINI_API_KEY=mock_test_key
GROK_API_KEY=mock_test_key
PROVIDER_GEMINI_ENABLED=true
PROVIDER_GROK_ENABLED=true
PROVIDER_DEEPSEEK_ENABLED=false
PROVIDER_OPENAI_ENABLED=false

STORAGE_BACKEND=local
MEDIA_STORAGE_PATH=/tmp/roxy_test_media

PAYMENT_PROVIDER_MODE=automatic
SAFEPAY_ENVIRONMENT=sandbox
STRIPE_PUBLISHABLE_KEY=pk_test_mock
VITE_API_BASE=/api/v1
VITE_RUNTIME_URL=http://localhost:8001
