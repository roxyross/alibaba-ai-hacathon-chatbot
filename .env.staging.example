# ==============================================================================
# ROXY-AI 2.0 — STAGING ENVIRONMENT CONFIGURATION TEMPLATE (.env.staging.example)
# ==============================================================================
# Mimics production infrastructure with pre-production data and credentials.
# ==============================================================================

APP_ENV=staging
ROXY_VERSION=2.0.0-rc
COMMIT_SHA=staging-commit-hash
HOST=0.0.0.0
PORT=8000
APP_BASE_URL=https://staging.roxy.ai
LOG_LEVEL=INFO

# Managed Cloud SQL or Staging Database
DATABASE_URL=postgresql+asyncpg://roxy_staging_user:CHANGE_ME@staging-db.internal:5432/roxy_staging
STRICT_MIGRATIONS=true

# Managed Redis
REDIS_URL=rediss://default:CHANGE_ME@staging-redis.internal:6380/0
RATE_LIMIT_TOKENS_PER_MINUTE=20000

# Server-Side Secrets — Stored in Cloud Secret Manager or GitHub Environments
JWT_SECRET=CHANGE_ME_STAGING_32_BYTE_HEX_KEY
JWT_SERVICE_SECRET=CHANGE_ME_STAGING_SERVICE_32_BYTE_HEX_KEY
JWT_EXPIRY_HOURS=72
MAGIC_LINK_TTL_MINUTES=15

# Staging Allowed Origins
CORS_ALLOWED_ORIGINS=https://staging.roxy.ai,https://staging-app.roxy.ai

# Staging Provider Keys
GEMINI_API_KEY=CHANGE_ME
GROK_API_KEY=CHANGE_ME
PROVIDER_GEMINI_ENABLED=true
PROVIDER_GROK_ENABLED=true
PROVIDER_DEEPSEEK_ENABLED=false
PROVIDER_OPENAI_ENABLED=false

STORAGE_BACKEND=gcs
GCS_BUCKET_NAME=roxy-staging-media-assets
MEDIA_STORAGE_PATH=/app/static/media

# Sandbox Payments
PAYMENT_PROVIDER_MODE=automatic
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
SAFEPAY_API_KEY=sec_test_CHANGE_ME
SAFEPAY_ENVIRONMENT=sandbox

# Public Frontend Variables
VITE_API_BASE=/api/v1
VITE_RUNTIME_URL=https://staging.roxy.ai
NEXT_PUBLIC_API_URL=https://staging.roxy.ai
